<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AlitasGo</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Google Fonts: Poppins -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
            html {
                height: 100%;
            }

            body {
                font-family: 'Poppins', sans-serif;
                background-color: #f8f9fa;
                min-height: 100vh;
                display: flex;
                flex-direction: column;
                margin: 0 !important;
                padding: 0 !important;
            }

            .navbar-custom {
                background: linear-gradient(135deg, #1f1f1f 0%, #111111 100%);
                border-bottom: 3px solid #ffc107;
            }

            .brand-logo {
                font-weight: 700;
                font-size: 1.35rem;
                letter-spacing: 0.5px;
                color: #ffffff !important;
            }

                .brand-logo span {
                    color: #ffc107;
                }

            .nav-link-custom {
                color: #d1d5db !important;
                font-weight: 500;
                padding: 0.5rem 1rem !important;
                border-radius: 6px;
                transition: all 0.2s ease-in-out;
            }

                .nav-link-custom:hover {
                    color: #ffffff !important;
                    background-color: rgba(255, 255, 255, 0.08);
                    transform: translateY(-1px);
                }

                .nav-link-custom.active {
                    color: #111111 !important;
                    background-color: #ffc107 !important;
                    font-weight: 600;
                }

            /* Anulación estricta de position absolute de site.css */
            footer.footer-alitas {
                position: static !important;
                margin-top: auto !important;
                background-color: #ffffff !important;
                border-top: 1px solid #e5e7eb !important;
                width: 100% !important;
                line-height: normal !important;
                white-space: normal !important;
            }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-md navbar-dark navbar-custom shadow-sm py-2">
            <div class="container-fluid px-4">
                <a class="navbar-brand brand-logo d-flex align-items-center" asp-controller="Pedidos" asp-action="FrmPedidosSalon">
                    🍗 Alitas<span>Go</span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#menuNavbar" aria-controls="menuNavbar"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-md-inline-flex justify-content-between" id="menuNavbar">
                    <ul class="navbar-nav me-auto ms-md-4 gap-1">
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-controller="Pedidos" asp-action="FrmPedidosSalon">
                                <i class="bi bi-layout-text-window-reverse me-1"></i> Salón / Pedidos
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-controller="Cocina" asp-action="Tablero">
                                <i class="bi bi-fire me-1"></i> Monitor de Cocina
                            </a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center text-light small">
                        <span class="badge bg-secondary me-2"><i class="bi bi-person-circle me-1"></i> Mozo Salón</span>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Contenedor central flexible que empuja el footer hasta el fondo -->
    <main role="main" class="flex-grow-1 container-fluid px-4 py-3">
        @RenderBody()
    </main>

    <footer class="footer-alitas py-3 shadow-sm">
        <div class="container-fluid px-4 d-flex justify-content-between align-items-center small text-muted">
            <div>
                &copy; 2026 <strong>AlitasGo</strong> - Gestión Gastronómica en Tiempo Real
            </div>
            <div>
                <span class="text-secondary me-3"><i class="bi bi-geo-alt me-1"></i> Trujillo, Perú</span>
                <span class="badge bg-dark">v1.2 SignalR</span>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>