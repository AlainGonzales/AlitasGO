@model CrearPedidoDto
@using AlitasGo.Domain.DTOs;

<h2>Registrar Pedido</h2>

@if (ViewBag.Errores != null)
{
    <div class="alert alert-danger">
        <ul>
            @foreach (var error in ViewBag.Errores)
            {
                <li>@error</li>
            }
        </ul>
    </div>
}

<form method="post">
    <div class="form-group mb-3">
        <label for="mesaId" class="form-label">Mesa</label>
        <input type="number" id="mesaId" name="mesaId" class="form-control" required />
    </div>

    <div class="form-group mb-3">
        <label for="usuarioId" class="form-label">Usuario</label>
        <input type="text" id="usuarioId" name="usuarioId" class="form-control" required />
    </div>

    <button type="submit" class="btn btn-primary">Registrar</button>
    <a href="/Pedidos/Index" class="btn btn-secondary">Cancelar</a>
</form>